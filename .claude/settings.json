{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "npx tsx scripts/gate-hook.ts", "timeout": 60 }]
      },
      {
        "matcher": "mcp__github__merge_pull_request",
        "hooks": [{ "type": "command", "command": "npx tsx scripts/gate-hook.ts", "timeout": 60 }]
      }
    ]
  },
  "enabledMcpjsonServers": ["jev", "github"]
}
